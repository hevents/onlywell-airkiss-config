<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- v1.2: 下拉刷新头部——初始高度 0 不占位；拖拽时跟手展开，松手回弹；刷新中显示转圈
         v1.3: 去掉负 margin（负 margin+动态高度在部分 ROM 上测量行为异常，会把后续内容顶出屏），灰条接受常规边距 -->
    <LinearLayout
        android:id="@+id/refresh_header"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#EEEEEE">
        <ProgressBar
            android:id="@+id/pb_refresh"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:indeterminate="true"
            android:visibility="gone" />
        <TextView
            android:id="@+id/tv_refresh_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="#666666"
            android:layout_marginLeft="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/tip"
        android:textSize="14sp"
        android:textColor="#222222"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tv_band"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#006600"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/et_ssid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_ssid"
        android:inputType="text"
        android:autofillHints="username" />

    <EditText
        android:id="@+id/et_pwd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_pwd"
        android:inputType="textVisiblePassword"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tv_pwd_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pwd_tip"
        android:textSize="12sp"
        android:textColor="#B00000"
        android:layout_marginTop="6dp" />

    <Button
        android:id="@+id/btn_send"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_send"
        android:layout_marginTop="16dp" />

    <ProgressBar
        android:id="@+id/pb_send"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="100"
        android:visibility="gone"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginTop="12dp" />

    <TextView
        android:id="@+id/tv_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#000000"
        android:layout_marginTop="16dp" />

</LinearLayout>
